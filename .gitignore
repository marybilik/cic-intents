# ---- Kaggle / data (do not redistribute raw text) ----
data/raw/
data/interim/
data/processed/
*.zip
*.tar.gz

# But KEEP the small splits and metrics we explicitly want to ship:
!data/splits/*.npz
!data/splits/*.csv
!data/splits/README.md
!results/*.csv
!results/*.json

